<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".WebActivity">

    <TextView
        android:id="@+id/w_tv_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="10dp"
        android:text="@string/app_description"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="normal" />

    <WebView
        android:layout_width="wrap_content"
        android:layout_height="300dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/w_bg_puzzles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:selectionRequired="true"
        app:checkedButton="@id/button_1"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_puzzle_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_name_1"
            android:textColor="@color/white"
            app:backgroundTint="@color/orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_puzzle_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_name_2"
            android:textColor="@color/white"
            app:backgroundTint="@color/orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_puzzle_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_name_3"
            android:textColor="@color/white"
            app:backgroundTint="@color/orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_puzzle_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_name_4"
            android:textColor="@color/white"
            app:backgroundTint="@color/orange" />

    </com.google.android.material.button.MaterialButtonToggleGroup>/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/w_bg_hints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:selectionRequired="true"
        app:checkedButton="@id/button_1"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_hint_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_button_1"
            android:textColor="@color/white"
            app:backgroundTint="@color/purple_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_hint_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_button_2"
            android:textColor="@color/white"
            app:backgroundTint="@color/purple_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/w_b_hint_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p_button_3"
            android:textColor="@color/white"
            app:backgroundTint="@color/purple_500" />

    </com.google.android.material.button.MaterialButtonToggleGroup>/>

</LinearLayout>